generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  avatar    String?
  bio       String?
  role      String   @default("EDITOR") // SUPER_ADMIN | ADMIN | EDITOR | VIEWER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts Account[]
  sessions Session[]
  posts    Post[]    @relation("PostAuthor")
  comments Comment[] @relation("CommentAuthor")

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CMS - BLOG & CONTENT
// ============================================================

model Post {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  excerpt  String?
  content  String // Rich text as HTML/JSON
  status   String  @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHED | ARCHIVED
  featured Boolean @default(false)

  // Primary category (slug from BLOG_CATEGORIES) — drives filtering,
  // related-article matching, and the on-card highlight.
  category String?

  // Cover / featured image shown on the post + in blog cards.
  coverImage String?

  // SEO fields
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  canonical       String?
  noindex         Boolean @default(false)
  nofollow        Boolean @default(false)

  // Relations
  authorId String
  author   User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  tags     Tag[]     @relation("PostTags")
  comments Comment[] @relation("PostComments")

  // Timestamps
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([category])
}

model Tag {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String  @unique
  description String?
  color       String? // Hex color for UI

  posts Post[] @relation("PostTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id      String @id @default(cuid())
  content String
  status  String @default("PENDING") // PENDING | APPROVED | SPAM | DELETED

  postId String
  post   Post   @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([status])
}

// ============================================================
// STATIC PAGES
// ============================================================

model Page {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  content String // Rich text as HTML/JSON

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String?

  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ============================================================
// MEDIA & FILES
// ============================================================

model Media {
  id       String  @id @default(cuid())
  filename String
  url      String  @unique
  alt      String?
  size     Int // File size in bytes
  width    Int? // Image dimensions
  height   Int?
  mimeType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mimeType])
}

// ============================================================
// NEWSLETTER & SUBSCRIPTIONS
// ============================================================

model Subscriber {
  id     String @id @default(cuid())
  email  String @unique
  status String @default("ACTIVE") // ACTIVE | UNSUBSCRIBED | BOUNCED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ============================================================
// ANALYTICS & TRACKING
// ============================================================

model PageView {
  id        String  @id @default(cuid())
  path      String
  referer   String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

// ============================================================
// SETTINGS & CONFIGURATION
// ============================================================

model SiteSettings {
  id              String  @id @default(cuid())
  siteTitle       String  @default("Digital Triangle")
  siteDescription String?
  logo            String?
  favicon         String?
  primaryColor    String?
  secondaryColor  String?
  accentColor     String?
  contactEmail    String?
  socialLinks     String? // JSON stringified { twitter, linkedin, etc }

  updatedAt DateTime @updatedAt
}

// ============================================================
// URL REDIRECTS
// ============================================================

model Redirect {
  id          String  @id @default(cuid())
  source      String  @unique // e.g. /old-page
  destination String // e.g. /new-page or https://...
  permanent   Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([isActive])
}

// ============================================================
// SITE PAGE SEO OVERRIDES
// ============================================================
// SEO metadata overrides for hardcoded/static routes (Home, About, Solutions,
// etc.) — these pages ship as code, not CMS content, so this only covers
// title/description/OG/canonical/indexing, not the visible page content.

model PageSeoOverride {
  id              String  @id @default(cuid())
  path            String  @unique // e.g. "/", "/about", "/solutions/organic-growth"
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonical       String?
  noindex         Boolean @default(false)
  nofollow        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// LEADS / FORM SUBMISSIONS
// ============================================================

model Lead {
  id       String  @id @default(cuid())
  type     String  @default("CONTACT") // CONTACT | CONSULTATION | AUDIT | DISCOVERY_AGENT
  name     String
  email    String
  phone    String?
  company  String?
  website  String?
  budget   String?
  timeline String? // expected start date / urgency, gathered by discovery agent
  services String? // comma-separated list
  goals    String? // comma-separated list (consultation)
  slot     String? // preferred time slot (consultation)
  message  String? // message / challenge text
  status   String  @default("NEW") // NEW | CONTACTED | QUALIFIED | CLOSED | SPAM
  source   String? // page path the lead came from

  conversationId     String?       @unique
  conversation       Conversation? @relation(fields: [conversationId], references: [id])
  websiteAnalysis    String? // JSON snapshot of analyze_website() output
  qualificationScore Int? // 0-100, set by the discovery agent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// DISCOVERY AGENT
// ============================================================

model Conversation {
  id             String  @id @default(cuid())
  page           String // path the widget was opened from
  persona        String // persona key used for this session
  outcome        String  @default("OPEN") // OPEN | BOOKED | EXITED | ABANDONED
  transcript     String  @db.Text // JSON array of {role, content, ts}
  extractedFacts String? // JSON object the agent has gathered so far
  costCents      Int     @default(0) // running per-model cost tally

  lead Lead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outcome])
  @@index([createdAt])
}

// ============================================================
// APP SECRETS
// ============================================================
// Credentials the hosting panel can't hold reliably (Hostinger mangles
// multi-line PEM values). Same trust boundary as the rest of this DB.

model AppSecret {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ============================================================
// CONTENT ENGINE
// ============================================================
// Self-ideating SEO content pipeline (System 2). P1 scope: ideate -> draft ->
// self-verify -> admin Content Queue, manual "run now" trigger. No GSC
// ingestion / decision-feedback learning yet (P3) -- nothing to learn from
// without that data, so no ContentLearning table until it's actually needed.

model ContentConcept {
  id          String   @id @default(cuid())
  title       String
  targetQuery String
  rationale   String   @db.Text
  score       Int // 0-100, self-assigned at ideation time
  status      String   @default("PENDING") // PENDING | DRAFTED | DISCARDED
  createdAt   DateTime @default(now())

  draft ContentDraft?

  @@index([status])
}

model ContentDraft {
  id              String         @id @default(cuid())
  conceptId       String         @unique
  concept         ContentConcept @relation(fields: [conceptId], references: [id])
  title           String
  slug            String         @unique
  excerpt         String?
  content         String         @db.Text // HTML, same shape as Post.content
  category        String? // BLOG_CATEGORIES slug
  coverImage      String? // AI-generated hero image (Supabase Storage URL)
  targetQuery     String
  whyItWillRank   String         @db.Text
  qaReport        String         @db.Text // JSON: { passed, checks: [{name, passed, note}] }
  status          String         @default("QUEUED") // QUEUED | APPROVED | REJECTED
  rejectionReason String?
  postId          String?        @unique // set once approved/edited into a real Post
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

// Topics Harsh wants covered. ideate() drains PENDING ones first (oldest
// first) and only self-ideates when the list is empty — so the engine is
// steerable without losing the autonomous fallback.
model ContentTopic {
  id        String   @id @default(cuid())
  topic     String
  notes     String? // optional angle / must-cover points
  status    String   @default("PENDING") // PENDING | USED
  createdAt DateTime @default(now())

  @@index([status])
}
